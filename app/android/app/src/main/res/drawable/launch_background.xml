<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12; later versions use the windowSplashScreen* theme attributes.
     Same layout as the Android 12 splash screen: the 108-unit icon canvas in a centred 288 dp box. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/app_surface" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
</layer-list>
