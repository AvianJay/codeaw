{
  "name": "codeaw-bridge",
  "version": "0.1.0",
  "description": "Run Claude Code / Codex / Kimi (via ACP) on this PC and drive them from anywhere over Tailscale.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "bin": {
    "codeaw-bridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bin": "npm run build && node scripts/build-binaries.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:terminal": "tsx scripts/terminal-smoke.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.6.0",
    "@lydell/node-pty": "^1.1.0",
    "cross-spawn": "^7.0.6",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
